# ─── Variables para el backend en RAILWAY ───────────────────────────────────
# Nunca pongas valores reales en este archivo ni lo subas con datos reales:
# solo sirve de plantilla. Configura los valores reales en el panel de
# variables de entorno de Railway.

# Clave secreta para firmar los tokens de sesión (JWT). Genera una aleatoria,
# por ejemplo con: openssl rand -hex 48
JWT_SECRET=

# Cuenta de administración/soporte que se crea automáticamente al arrancar.
# Se guarda SIEMPRE hasheada (bcrypt) en la base de datos, nunca en texto plano.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# URL pública de tu frontend en Vercel (se usa para construir el enlace de
# recuperación de contraseña que se envía por email).
APP_URL=https://tu-app.vercel.app

# Opcional: envío real de emails de recuperación vía Resend (resend.com).
# Si no se configuran, el enlace de recuperación se imprime en los logs
# del servidor (modo desarrollo).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Variables para el frontend en VERCEL ───────────────────────────────────
# URL del backend real en Railway
VITE_API_URL=https://mis-modelos-ia-propios-production.up.railway.app

# ─── MOTOR DE IA (OBLIGATORIO) ──────────────────────────────────────────────
# Zoco IA funciona sobre Claude de Anthropic. Es la ÚNICA clave de modelo que
# el sistema necesita: sin ella el backend arranca, pero el chat y el Ordenador
# devuelven error. Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── EL ORDENADOR DE ZOCO (agente autónomo, ruta /computer) ─────────────────
# Límite de iteraciones por ejecución del bucle. Al alcanzarlo la tarea queda
# "pausada" y el usuario la reanuda con un mensaje: no se pierde el trabajo.
COMPUTER_MAX_ITERATIONS=60

# Nº de mensajes que se conservan íntegros en el contexto antes de resumir los
# más antiguos. Baja este valor si aparecen errores de contexto excedido.
COMPUTER_MAX_CONTEXT_MESSAGES=80

# Timeout de cada comando de terminal y de cada llamada al modelo, en ms.
COMPUTER_SHELL_TIMEOUT_MS=120000
COMPUTER_MODEL_TIMEOUT_MS=300000

# Base pública del backend. La necesita la herramienta "exponer_puerto" para
# devolver URLs que el usuario pueda abrir. Ejemplo: https://zocoia.es
COMPUTER_PUBLIC_BASE=https://zocoia.es

# OPCIONAL: navegador visual real con capturas de pantalla (E2B Desktop).
# Si se deja vacío el agente sigue funcionando, pero solo lee páginas como
# texto: la herramienta "navegador" se desactiva y se le avisa en el prompt.
E2B_API_KEY=

# OPCIONAL: búsqueda web de alta calidad vía Tavily (tavily.com). Sin ella se
# usa el buscador de reserva, con resultados más pobres.
TAVILY_API_KEY=

# Token de GitHub (permisos "repo") usado por el agente para clonar, hacer
# commit/push y abrir Pull Requests. Genera uno nuevo y dedicado en
# https://github.com/settings/tokens — nunca reutilices tokens compartidos
# fuera de este servidor.
GITHUB_TOKEN=

# API de Coolify, para que el agente pueda disparar el redespliegue al
# terminar una tarea (Panel Coolify -> Keys & Tokens -> API tokens).
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=

# Carpeta temporal donde el agente clona cada repo mientras trabaja, y
# límite de pasos del bucle (protección contra bucles infinitos).
AGENT_WORKSPACE_DIR=/tmp/manus-agent-workspaces
AGENT_MAX_STEPS=25
